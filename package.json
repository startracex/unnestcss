{
  "name": "unnestcss",
  "version": "1.2.1",
  "description": "A library for un-nesting CSS",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepare": "lefthook install",
    "test": "vitest"
  },
  "devDependencies": {
    "@startracex/dev-config": "^0.7.0",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "rollup": "4.68.0",
    "rollup-plugin-oxc": "0.8.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    },
    "./*.js": {
      "import": "./out/*.js",
      "require": "./out/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "src"
  ],
  "license": "MIT",
  "author": "startracex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/unnestcss.git"
  },
  "packageManager": "pnpm@12.16.1"
}
